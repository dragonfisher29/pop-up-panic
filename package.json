    "sim:bot": "vite-node scripts/sim-bot.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0"
  }
}
